rules_version = '2';

// The website may only CREATE enquiries. Nobody can read, change or delete
// them from the browser. Read them in the Firebase console instead.
service cloud.firestore {
  match /databases/{database}/documents {
    match /enquiries/{enquiryId} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'tripType', 'travelMonth', 'adults', 'children',
          'fromCity', 'message', 'consent', 'sourcePage', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.tripType in ['Students', 'Family', 'Honeymoon']
        && request.resource.data.travelMonth is string
        && request.resource.data.travelMonth.size() <= 20
        && request.resource.data.adults is int
        && request.resource.data.children is int
        && request.resource.data.fromCity is string
        && request.resource.data.fromCity.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.consent == true
        && request.resource.data.sourcePage is string
        && request.resource.data.sourcePage.size() <= 200
        && request.resource.data.createdAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
